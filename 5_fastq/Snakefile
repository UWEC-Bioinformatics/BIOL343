configfile: "config.yaml"

rule all:
    input:
        "multiqc_axolotl/multiqc_report.html"

rule fetch_fastq:
    output:
        "fastq/{samples}_1.fastq.gz",
        "fastq/{samples}_2.fastq.gz"
    threads: 16    
    shell:
        "parallel-fastq-dump --split-files --sra-id {wildcards.samples} --threads {threads} --outdir fastq --gzip"
       
rule fastq_qc:
    input:
        "fastq/{samples}_1.fastq.gz", 
        "fastq/{samples}_2.fastq.gz" 
    output:
        "fastq/qc/{samples}_1_fastqc.html",
        "fastq/qc/{samples}_1_fastqc.zip",
        "fastq/qc/{samples}_2_fastqc.html",
        "fastq/qc/{samples}_2_fastqc.zip"
    threads: 32
    shell:
        "fastqc -t {threads} {input} -o fastq/qc"

rule trim_filter:
    input:
        "fastq/{samples}_1.fastq.gz", 
        "fastq/{samples}_2.fastq.gz"
    output:
        "trimmed_axolotl/{samples}_1.fastq.gz",
        "trimmed_axolotl/{samples}_2.fastq.gz",
    shell:
        "cutadapt -j 32 -m 20 -u 10 -U 10 "
        "-a AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC " 
        "-A AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGTAGATCTCGGTGGTCGCCGTATCATT "
        "-o {output[0]} -p {output[1]} {input[0]} {input[1]};" 
        # add indexes since you have to specify a paired output for this rule

rule trim_qc:
   input:
        "trimmed_axolotl/{samples}_1.fastq.gz",
        "trimmed_axolotl/{samples}_2.fastq.gz"
   output:
        "trimmed_axolotl/qc/{samples}_1_fastqc.html",
        "trimmed_axolotl/qc/{samples}_1_fastqc.zip",
        "trimmed_axolotl/qc/{samples}_2_fastqc.html",
        "trimmed_axolotl/qc/{samples}_2_fastqc.zip"
   threads: 32
   shell:
        "fastqc -t {threads} {input} -o trimmed_axolotl/qc"

rule report: 
    input:
        fastq_html = expand("fastq/qc/{samples}_{reads}_fastqc.html", samples=config["samples"], reads=[1,2]),
        fastq_zip = expand("fastq/qc/{samples}_{reads}_fastqc.zip", samples=config["samples"], reads=[1,2]),
        trimmed_html = expand("trimmed_axolotl/qc/{samples}_{reads}_fastqc.html", samples=config["samples"], reads=[1,2]),
        trimmed_zip = expand("trimmed_axolotl/qc/{samples}_{reads}_fastqc.zip", samples=config["samples"], reads=[1,2])
    output:
        "multiqc_axolotl/multiqc_report.html"
    shell:
        "multiqc --force -n multiqc_report.html -o multiqc_axolotl fastq/qc trimmed_axolotl/qc"




 
