#START @ END AND WORK UP (BACKWARDS)!

configfile: "config.yaml"

rule all:
    input:
        "multiqc/multiqc_report.html"

rule fetch_fastq:
    output:
        #is it a matter of "knowing" the output or "naming" the output???
        "fastq/{sample}_1.fastq.gz"
    shell: 
        "parallel-fastq-dump --split-files --sra-id {wildcards.sample} --threads 16 --outdir fastq --gzip;"

rule fastq_qc:
    input:
        "fastq/{sample}_1.fastq.gz"
        #does the shell command differ between running 20 times on different fastqs vs running once with a 'list' of 20 fastqs
    output:
        "fastq/qc/{sample}_1.fastqc.html",
        "fastq/qc/{sample}_1.fastqc.zip"

    shell:
        "!fastqc -t 32 {input} -o fastq/qc"

rule trim_filter:
    input:
        "fastq/{sample}_1.fastq.gz"
    output:
        "trimmed/{sample}_1.fastq.gz"
    shell:
        "cutadapt -j 32 -u 12 -u -3 -m 20 "
        "-o {output} {input};"

rule trim_qc:
    input:
        "trimmed/{sample}_1.fastq.gz"
    output:
        "trimmed/qc/{sample}_1.fastqc.html",
        "trimmed/qc/{sample}_1.fastqc.zip"
    shell:
        "!fastqc -t 32 {input} -o trimmed/qc"

rule report:
    input:
        #output from fastq_qc and trim_qc
        fastq_html = expand("fastq/qc/{sample}_1.fastqc.html", sample=config["fastqs"]),
        fastq_zip = expand("fastq/qc/{sample}_1.fastqc.zip", sample=config["fastqs"]),
        trimmed_html = expand("trimmed/qc/{sample}_1.fastqc.html", sample=config["fastqs"]),
        trimmed_zip = expand("trimmed/qc/{sample}_1.fastqc.zip", sample=config["fastqs"])
    output:
        "multiqc/multiqc_report.html"
    shell:
        "multiqc -d fastq/qc --outdir multiqc trimmed/qc"