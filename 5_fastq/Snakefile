rule fetch_fastq:
    input: 
        expand("fastq/{sample}.fastq.gz", sample=config["samples"])
    output:
        "fastq/{sample}.fastq.gz"
    threads: 16    
    shell:
        "parallel-fastq-dump --split-files --sra-id $line --gzip;"

       
